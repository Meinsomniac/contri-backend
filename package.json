    "prisma:generate": "prisma generate --schema=./src/infrastructure/database/prisma/schema.prisma --config ./src/infrastructure/config/prisma.config.ts",
    "prisma:push": "prisma db push --schema=./src/infrastructure/database/prisma/schema.prisma --config ./src/infrastructure/config/prisma.config.ts"
  },
