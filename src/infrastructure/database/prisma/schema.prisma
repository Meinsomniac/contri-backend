// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// USER
// ============================================================

model User {
  id            String       @id @default(cuid())
  publicId      String       @unique
  email         String?      @unique
  phone         String?      @unique
  name          String
  avatar        String?
  password      String?
  emailVerified Boolean      @default(false)
  phoneVerified Boolean      @default(false)
  isOnboarded   Boolean      @default(false)
  isPlaceholder Boolean      @default(false)
  currency      String       @default("USD")
  language      String       @default("en")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  authProvider  AuthProvider @default(EMAIL)
  authId        String?

  // Relations
  friends                FriendShip[]        @relation("UserFriends")
  friendOf               FriendShip[]        @relation("FriendOf")
  contactIdentifiers     ContactIdentifier[]
  otpVerificationsTokens OtpVerification[]
  settings               UserSettings?

  // Group relations
  createdGroups    Group[]       @relation("GroupCreator")
  groupMemberships GroupMember[]

  // Expense relations
  createdExpenses Expense[]        @relation("ExpenseCreator")
  expensePayers   ExpensePayer[]
  expenseSplits   ExpenseSplit[]
  expenseComments ExpenseComment[]

  // Settlement relations
  settlementsPaid     Settlement[] @relation("SettlementPayer")
  settlementsReceived Settlement[] @relation("SettlementPayee")

  // Balance cache
  balancesAsUserA BalanceCache[] @relation("BalanceUserA")
  balancesAsUserB BalanceCache[] @relation("BalanceUserB")

  // Activity feed
  activityAsActor  ActivityFeed[] @relation("ActivityActor")
  activityAsTarget ActivityFeed[] @relation("ActivityTarget")

  @@index([phone])
  @@index([email])
  @@index([createdAt])
  @@index([isPlaceholder])
}

model OtpVerification {
  id        String           @id @default(cuid())
  userId    String
  secret    String
  expiresAt DateTime
  createdAt DateTime         @default(now())
  type      VerificationType @default(VERIFY_EMAIL)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FriendShip {
  id          String           @id @default(cuid())
  userId      String
  friendId    String
  displayName String
  status      FriendShipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user   User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@index([status])
}

model ContactIdentifier {
  id             String         @id @default(cuid())
  userId         String
  identifier     String
  identifierType IdentifierType
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, identifierType])
  @@index([userId])
  @@index([identifier, identifierType])
}

// ============================================================
// USER SETTINGS
// ============================================================

model UserSettings {
  userId String @id

  // Notification Preferences
  notifGroupAdded     Boolean @default(true) // When user is added to a group
  notifFriendAdded    Boolean @default(true) // When someone adds user as a friend
  notifExpenseAdded   Boolean @default(true) // When an expense is added involving user
  notifExpenseDeleted Boolean @default(true) // When an expense is deleted
  notifCommentAdded   Boolean @default(true) // When someone comments on user's expense
  notifExpenseDue     Boolean @default(true) // When an expense is due

  // Push / Email channels
  pushEnabled  Boolean @default(true)
  emailEnabled Boolean @default(true)
  pushToken    String? // FCM / APNs device token

  // App Preferences
  defaultCurrency    String      @default("USD")
  defaultSplitMethod SplitMethod @default(EQUAL)
  theme              String      @default("light") // light | dark | system
  decimalPrecision   Int         @default(2)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// GROUPS
// ============================================================

model Group {
  id             String    @id @default(cuid())
  publicId       String    @unique
  name           String
  avatar         String?
  // Rules / description written by the creator
  note           String?
  // Recurring settle-up schedule stored as JSON
  // e.g. { "type": "WEEKLY", "dayOfWeek": 1, "hour": 9 }
  //      { "type": "MONTHLY", "dayOfMonth": 1, "hour": 9 }
  settleSchedule Json?
  nextSettleAt   DateTime?
  isArchived     Boolean   @default(false)
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  creator     User           @relation("GroupCreator", fields: [createdBy], references: [id])
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  balances    BalanceCache[]
  activities  ActivityFeed[]

  @@index([publicId])
  @@index([createdBy])
}

// Explicit junction table — replaces the implicit Prisma many-to-many.
// Needed so we can store isAdmin, joinedAt, leftAt on the membership itself.
model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  isAdmin  Boolean   @default(false)
  joinedAt DateTime  @default(now())
  leftAt   DateTime? // soft-removal from group

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

// ============================================================
// EXPENSES
// ============================================================

model Expense {
  id             String        @id @default(cuid())
  publicId       String        @unique
  title          String
  totalAmount    Decimal       @db.Decimal(19, 4)
  currency       String        @default("USD")
  category       String?
  receiptUrl     String?
  notes          String?
  expenseDate    DateTime      @default(now()) @db.Date
  status         ExpenseStatus @default(ACTIVE)
  groupId        String
  createdBy      String
  // Client-generated UUID — prevents duplicate submissions on network retry
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  // Relations
  group      Group            @relation(fields: [groupId], references: [id])
  creator    User             @relation("ExpenseCreator", fields: [createdBy], references: [id])
  payers     ExpensePayer[]
  splits     ExpenseSplit[]
  comments   ExpenseComment[]
  activities ActivityFeed[]

  @@index([groupId, createdAt(sort: Desc)])
  @@index([createdBy, createdAt(sort: Desc)])
}

// Who paid — supports multiple payers on one expense.
// e.g. Alice paid $30, Bob paid $20 on a $50 expense.
model ExpensePayer {
  id         String  @id @default(cuid())
  expenseId  String
  userId     String
  amountPaid Decimal @db.Decimal(19, 4)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([expenseId])
}

// Who owes how much — stores both the raw input and the resolved amount.
// rawValue meaning depends on splitMethod:
//   EQUAL      → not used (computed automatically)
//   EXACT      → exact dollar amount
//   PERCENTAGE → 0–100
//   SHARES     → integer share count
// computedAmount is ALWAYS the final resolved dollar amount (what the UI shows).
model ExpenseSplit {
  id             String      @id @default(cuid())
  expenseId      String
  userId         String
  splitMethod    SplitMethod
  rawValue       Decimal     @db.Decimal(19, 4)
  computedAmount Decimal     @db.Decimal(19, 4)
  isSettled      Boolean     @default(false)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([userId, isSettled])
  @@index([expenseId])
}

model ExpenseComment {
  id        String    @id @default(cuid())
  expenseId String
  userId    String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([expenseId, createdAt])
}

// ============================================================
// SETTLEMENTS
// ============================================================

// A settlement is a direct payment between two users to clear a debt.
// Flow: payer creates (PENDING) → payee confirms (CONFIRMED) or cancels (CANCELLED).
model Settlement {
  id             String           @id @default(cuid())
  publicId       String           @unique
  groupId        String? // null = settlement outside a group context
  payerId        String
  payeeId        String
  amount         Decimal          @db.Decimal(19, 4)
  currency       String           @default("USD")
  status         SettlementStatus @default(PENDING)
  note           String?
  idempotencyKey String?          @unique
  settledAt      DateTime? // set when status → CONFIRMED
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  group      Group?         @relation(fields: [groupId], references: [id])
  payer      User           @relation("SettlementPayer", fields: [payerId], references: [id])
  payee      User           @relation("SettlementPayee", fields: [payeeId], references: [id])
  activities ActivityFeed[]

  @@index([payerId, status])
  @@index([payeeId, status])
  @@index([groupId])
}

// ============================================================
// BALANCE CACHE
// ============================================================

// Denormalized pairwise balance — updated inside the same DB transaction
// as any expense or settlement write. Never computed on the fly for reads.
//
// Invariant: userAId < userBId (lexicographic) — enforced at application layer.
// netAmount > 0  → userA owes userB
// netAmount < 0  → userB owes userA
model BalanceCache {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  groupId   String? // null = overall balance across all groups
  netAmount Decimal  @default(0) @db.Decimal(19, 4)
  currency  String   @default("USD")
  updatedAt DateTime @updatedAt

  userA User   @relation("BalanceUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User   @relation("BalanceUserB", fields: [userBId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId, groupId, currency])
  @@index([userAId])
  @@index([userBId])
}

// ============================================================
// ACTIVITY FEED
// ============================================================

// Append-only event log — rows are never updated or soft-deleted.
// If an expense is deleted, a NEW row with EXPENSE_DELETED is inserted.
// metadata stores a snapshot of context at event time so deleted/renamed
// entities still render correctly in the feed (no joins needed for display).
model ActivityFeed {
  id           String            @id @default(cuid())
  actorId      String
  eventType    ActivityEventType
  groupId      String?
  expenseId    String?
  settlementId String?
  targetUserId String? // the user an action was performed on
  // Snapshot: actor name, group name, amount, expense title, etc.
  metadata     Json              @default("{}")
  createdAt    DateTime          @default(now())

  actor      User        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  group      Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  expense    Expense?    @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  settlement Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  targetUser User?       @relation("ActivityTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([groupId, createdAt(sort: Desc)])
}

// ============================================================
// EXCHANGE RATES  (multi-currency support)
// ============================================================

model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(19, 8)
  fetchedAt    DateTime @default(now())

  @@index([fromCurrency, toCurrency])
}

// ============================================================
// ENUMS
// ============================================================

enum VerificationType {
  FORGOT_PASSWORD
  FORGOT_EMAIL
  VERIFY_EMAIL
  CHANGE_PASSWORD
  CHANGE_EMAIL
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum FriendShipStatus {
  ACTIVE
  REMOVED
  BLOCKED
}

enum IdentifierType {
  EMAIL
  PHONE
}

enum SplitMethod {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
}

enum ExpenseStatus {
  ACTIVE
  DELETED
  SETTLED
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ActivityEventType {
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_CREATED
  SETTLEMENT_CONFIRMED
  GROUP_CREATED
  GROUP_MEMBER_ADDED
  GROUP_MEMBER_REMOVED
  FRIEND_ADDED
  COMMENT_ADDED
  PROFILE_UPDATED
}
